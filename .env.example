# Copy to .env (laptop). On the Space and GitHub these are "secrets" instead.
TELEGRAM_TOKEN=123456789:AA...from-BotFather
TELEGRAM_CHAT_ID=123456789

# Notion (README section 3): the connection's secret, and the link of the page you connected
NOTION_TOKEN=ntn_...
NOTION_PAGE=https://www.notion.so/Price-Watcher-1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d

HF_TOKEN=hf_...write-token
HF_DATASET=yourname/price-history

# Optional
# RUNNING_ON=laptop          # auto: space / laptop
# STORES=amazon_eg           # only these sites/stores on this device
# EXCLUDE_STORES=noon        # all except these
# BOT_COMMANDS=0             # set on the second device so only one answers /commands
# LOOP_ENABLED=0             # Space smoke test: endpoints only, no checking
# USER_AGENT=...             # your browser's User-Agent (from chrome://version)
# FETCH_BACKEND={"amazon_eg":"browser","jumia":"browser","noon":"browser_visible"} # optional local Chromium readers
# SPACE_URL=https://yourname-price-watcher.hf.space   # used by scripts/check_space.py
# SITES=https://www.noon.com/egypt-en/,https://www.amazon.eg/   # overrides "sites" in watchlist.json
